# ═══════════════════════════════════════════════════════════
#  SafEye — Environment Configuration
#  Copy to .env and fill in real values. NEVER commit .env
# ═══════════════════════════════════════════════════════════

# ─── Flask ───
FLASK_ENV=production
FLASK_SECRET_KEY=CHANGE_ME_random_64_char_string
JWT_SECRET_KEY=CHANGE_ME_different_random_64_char_string

# ─── Server ───
PORT=7860
HOST=0.0.0.0
WORKERS=2
THREADS=4
TIMEOUT=600

# ─── Frontend ───
FRONTEND_URL=http://localhost:3000

# ─── CORS (comma-separated additional origins) ───
EXTRA_CORS_ORIGINS=

# ─── File Uploads ───
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads

# ─── Model Config ───
DOWNLOAD_MODELS_ON_STARTUP=false
MODELS_DIR=models

# ─── OAuth (Google) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth (GitHub) ───
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Azure Blob Storage (Model Downloads) ───
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ai-models
AZURE_IMAGE_BLOBS=image_model/best_deepfake_detector.pth
AZURE_AUDIO_BLOBS=audio_model/config.json,audio_model/model.safetensors,audio_model/preprocessor_config.json
AZURE_TEXT_BLOBS=text_model/config.json,text_model/added_tokens.json,text_model/special_tokens_map.json,text_model/tokenizer_config.json,text_model/model.safetensors,text_model/spm.model

# ─── Rate Limiting ───
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200/hour
RATELIMIT_ANALYSIS=30/minute

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FORMAT=json
